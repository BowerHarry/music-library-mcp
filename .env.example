# Copy to .env (never commit .env).
# Public address of this server (Cloudflare Tunnel or similar), used for OAuth.
PUBLIC_URL=https://library.example.com
# Login password for Claude (12+ characters). Or leave it out and share another .env's:
LIBRARY_PASSWORD=
# ENV_FILES=/path/to/other/.env      # e.g. a docker .env holding MUSIC_AGENT_PASSWORD
# ENV_FILES_KEYS=LIBRARY_PASSWORD,MUSIC_AGENT_PASSWORD,OWNER_NAME
# OWNER_NAME=                        # optional: lets Claude address you by name
# HOST=127.0.0.1                     # use 0.0.0.0 if your tunnel can't reach localhost
# PORT=8091
# REMATCH_BACKUP_DIR=                # default: next to the Music media folder
# PLAYLIST_EXPORT=auto               # export playlists to <music folder>/.playlists.json (or a path)
# PLAYLIST_EXPORT_EVERY=1800         # also re-export this often (seconds), for edits made in Music
